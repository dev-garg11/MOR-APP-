# Copy this file to ".env" in the mo_frontend project root (same folder as package.json).
# Expo automatically loads any variable prefixed with EXPO_PUBLIC_ into your app code.

# --- For Expo WEB (localhost) — usually no need to set this, default works ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- For Android emulator — usually no need to set this, default works ---
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# --- For a REAL PHONE via Expo Go (uncomment and set to your laptop's LAN IP) ---
# Find your IP: Windows -> `ipconfig` (look for IPv4 Address), Mac/Linux -> `ifconfig`
# Phone and laptop must be on the SAME Wi-Fi network.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.14:8000
